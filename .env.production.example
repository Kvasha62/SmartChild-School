# Production/staging template for config.production_settings.
# Copy to a private .env and replace EVERY CHANGE_ME value. Never commit secrets.
# Generate key: python -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_SETTINGS_MODULE=config.production_settings
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_random_50_plus_character_secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=school.example.org,www.school.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://school.example.org,https://www.school.example.org
WAGTAILADMIN_BASE_URL=https://school.example.org
DJANGO_MEDIA_ROOT=/srv/media

# PostgreSQL bootstrap account is distinct from the application account.
# Compose passes DB_ADMIN_USER/DB_ADMIN_PASSWORD only to the db service.
DB_NAME=smartchild
DB_ADMIN_USER=smartchild_admin
DB_ADMIN_PASSWORD=CHANGE_ME_database_admin_password
DB_USER=smartchild_app
DB_PASSWORD=CHANGE_ME_application_database_password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60
# DB_SSLMODE=require

# SMTP provider is not selected yet; replace all values before staging.
DJANGO_EMAIL_HOST=smtp.example.org
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_HOST_USER=CHANGE_ME_smtp_user
DJANGO_EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
DJANGO_DEFAULT_FROM_EMAIL=SmartChild <no-reply@school.example.org>
DJANGO_EMAIL_TIMEOUT=10
# DJANGO_SERVER_EMAIL=SmartChild <no-reply@school.example.org>

# Set true only behind trusted TLS ingress that overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO

# The reverse proxy is bound to loopback by default.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
