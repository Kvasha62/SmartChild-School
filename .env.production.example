# Production environment template for config.production_settings.
# Copy these names into your platform's secret/environment configuration.
# NEVER commit real values. Every CHANGE_ME value below is rejected or
# unusable on purpose; see docs/technical/production-deployment-runbook.md.

# --- Required ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_random_50_plus_character_secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=school.example.org
WAGTAILADMIN_BASE_URL=https://school.example.org
# Absolute path on PERSISTENT storage mounted into the app environment.
DJANGO_MEDIA_ROOT=/srv/media

DB_NAME=smartchild
DB_USER=smartchild
DB_PASSWORD=CHANGE_ME_database_password
DB_HOST=db.internal.example.org
DB_PORT=5432

DJANGO_EMAIL_HOST=smtp.example.org
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_HOST_USER=CHANGE_ME_smtp_user
DJANGO_EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
DJANGO_DEFAULT_FROM_EMAIL=SmartChild <no-reply@school.example.org>

# --- Optional (defaults shown) ---
# DJANGO_SETTINGS_MODULE=config.production_settings
# DJANGO_CSRF_TRUSTED_ORIGINS=https://school.example.org
# DJANGO_STATIC_ROOT=/app/staticfiles
# DJANGO_SERVER_EMAIL=SmartChild <no-reply@school.example.org>
# DJANGO_EMAIL_TIMEOUT=10
# DB_CONN_MAX_AGE=60
# DB_SSLMODE=require
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=3600
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false
# Enable ONLY behind a trusted proxy that overwrites X-Forwarded-Proto:
# DJANGO_TRUST_PROXY_HEADERS=false
# DJANGO_LOG_LEVEL=INFO
# WEB_CONCURRENCY=2
