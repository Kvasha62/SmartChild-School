# Copy to .env.production, restrict file permissions (chmod 600), and replace
# EVERY example value. Never commit the real .env.production file.
PUBLIC_DOMAIN=school.example.org
DJANGO_SECRET_KEY=REPLACE_WITH_python_secrets_token_urlsafe_50
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=school.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://school.example.org
WAGTAILADMIN_BASE_URL=https://school.example.org

# Application DB role: do not use the PostgreSQL administrator account here.
DB_NAME=smartchild
DB_USER=smartchild_app
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_APP_DB_PASSWORD
DB_CONN_MAX_AGE=60

# PostgreSQL bootstrap administrator, used only by the db container and backups.
POSTGRES_ADMIN_USER=smartchild_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ADMIN_PASSWORD

# SMTP settings. Use a real mail provider and keep credentials out of Git.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=SmartChild <noreply@example.org>
SERVER_EMAIL=SmartChild <server@example.org>

# Enable HTTPS redirect and secure cookies. Begin with short HSTS during
# cutover; increase after TLS, redirects and all required hostnames are verified.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
