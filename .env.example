# Copy to .env, then replace DJANGO_SECRET_KEY with a random local value.
DJANGO_SECRET_KEY=replace-me-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_NAME=smartchild
DB_USER=smartchild
DB_PASSWORD=local-development-only
DB_HOST=127.0.0.1
DB_PORT=5432
