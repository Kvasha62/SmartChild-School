# Local development. Never commit a real .env file or production credentials.
DJANGO_SECRET_KEY=replace-me-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
WAGTAILADMIN_BASE_URL=http://localhost:8000

# In production, keep DJANGO_DEBUG=false and replace all example credentials.
# The production configuration rejects placeholder secrets, wildcard hosts,
# local-only database passwords, non-HTTPS admin URLs, and console email.
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# WAGTAILADMIN_BASE_URL=https://www.example.com
# DJANGO_TRUST_PROXY_SSL_HEADER=true
DJANGO_SECURE_HSTS_SECONDS=0

# Used by the production Compose file (DB_HOST is overridden to "db" in its app container).
DB_NAME=smartchild
DB_USER=smartchild
DB_PASSWORD=local-development-only
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
# Set DB_SSLMODE=require when using a managed PostgreSQL service that requires TLS.

# Local development uses console email automatically. Production defaults to SMTP.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_EMAIL_USE_SSL=false
DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost
# DJANGO_SERVER_EMAIL=errors@example.com

# Production Compose publishes its reverse proxy on loopback by default.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
