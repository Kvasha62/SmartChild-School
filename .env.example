# Copy to .env, then replace DJANGO_SECRET_KEY with a random local value.
DJANGO_SECRET_KEY=replace-me-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local email defaults to the console backend (messages are printed, not
# sent), so Wagtail notifications need no SMTP server. Leave unset locally.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost

# Production uses config.production_settings with a different, strict
# contract; see .env.production.example and
# docs/technical/production-deployment-runbook.md. Do not reuse this file
# or its placeholder values in production.

DB_NAME=smartchild
DB_USER=smartchild
DB_PASSWORD=local-development-only
DB_HOST=127.0.0.1
DB_PORT=5432
